diff --git a/ggml/src/ggml-metal/CMakeLists.txt b/ggml/src/ggml-metal/CMakeLists.txt
index 42054d8..21348d9 100644
--- a/ggml/src/ggml-metal/CMakeLists.txt
+++ b/ggml/src/ggml-metal/CMakeLists.txt
@@ -40,7 +40,7 @@ if (GGML_METAL_EMBED_LIBRARY)
     set(METALLIB_SOURCE_EMBED_TMP "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed.metal.tmp")
 
     add_custom_command(
-        OUTPUT "${METALLIB_EMBED_ASM}"
+        OUTPUT "${METALLIB_EMBED_ASM}" "${METALLIB_SOURCE_EMBED}"
         COMMAND echo "Embedding Metal library"
         COMMAND sed -e "/__embed_ggml-common.h__/r ${METALLIB_COMMON}"       -e "/__embed_ggml-common.h__/d"         < "${METALLIB_SOURCE}"           > "${METALLIB_SOURCE_EMBED_TMP}"
         COMMAND sed -e "/\#include \"ggml-metal-impl.h\"/r ${METALLIB_IMPL}" -e "/\#include \"ggml-metal-impl.h\"/d" < "${METALLIB_SOURCE_EMBED_TMP}" > "${METALLIB_SOURCE_EMBED}"
@@ -56,6 +56,40 @@ if (GGML_METAL_EMBED_LIBRARY)
     )
 
     target_sources(ggml-metal PRIVATE "${METALLIB_EMBED_ASM}")
+
+    # LocalBase: also embed a build-time compiled metallib so that devices whose
+    # runtime compile options match (BF16 available, no tensor API) skip the
+    # multi-second source compile on every cold Metal shader cache.
+    option(GGML_METAL_EMBED_PRECOMPILED "ggml: embed a precompiled Metal library next to the source" OFF)
+    if (GGML_METAL_EMBED_PRECOMPILED)
+        if (NOT GGML_METAL_MACOSX_VERSION_MIN)
+            message(FATAL_ERROR "GGML_METAL_EMBED_PRECOMPILED requires GGML_METAL_MACOSX_VERSION_MIN")
+        endif()
+
+        add_compile_definitions(GGML_METAL_EMBED_PRECOMPILED)
+
+        set(METALLIB_PRECOMPILED_AIR "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed.air")
+        set(METALLIB_PRECOMPILED     "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed.metallib")
+        set(METALLIB_PRECOMPILED_ASM "${CMAKE_CURRENT_BINARY_DIR}/autogenerated/ggml-metal-embed-precompiled.s")
+
+        add_custom_command(
+            OUTPUT "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND xcrun -sdk macosx metal -O3 -mmacosx-version-min=${GGML_METAL_MACOSX_VERSION_MIN} -DGGML_METAL_EMBED_LIBRARY=1 -DGGML_METAL_HAS_BF16=1 -c "${METALLIB_SOURCE_EMBED}" -o "${METALLIB_PRECOMPILED_AIR}"
+            COMMAND xcrun -sdk macosx metallib "${METALLIB_PRECOMPILED_AIR}" -o "${METALLIB_PRECOMPILED}"
+            COMMAND echo ".section __DATA,__ggml_metalbin"                 >  "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND echo ".p2align 4"                                      >> "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_precompiled_start"         >> "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_precompiled_start:"               >> "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND echo .incbin "\"${METALLIB_PRECOMPILED}\""             >> "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND echo ".globl _ggml_metallib_precompiled_end"           >> "${METALLIB_PRECOMPILED_ASM}"
+            COMMAND echo "_ggml_metallib_precompiled_end:"                 >> "${METALLIB_PRECOMPILED_ASM}"
+            DEPENDS "${METALLIB_SOURCE_EMBED}"
+            COMMENT "Compile and embed precompiled Metal library"
+            VERBATIM
+        )
+
+        target_sources(ggml-metal PRIVATE "${METALLIB_PRECOMPILED_ASM}")
+    endif()
 else()
     # copy metal files to bin directory
     configure_file(../ggml-common.h  ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/ggml-common.h     COPYONLY)
diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index f0ef9ab..b1b01f9 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -129,6 +129,34 @@ ggml_metal_library_t ggml_metal_library_init(ggml_metal_device_t dev) {
         extern const char ggml_metallib_end[];
 
         src = [[NSString alloc] initWithBytes:ggml_metallib_start length:(ggml_metallib_end-ggml_metallib_start) encoding:NSUTF8StringEncoding];
+
+#if GGML_METAL_EMBED_PRECOMPILED
+        // LocalBase: the precompiled library was built with the same macros the
+        // source compile below would use when BF16 is available and the tensor
+        // API is not. Any other device configuration compiles from source.
+        if (ggml_metal_device_get_props(dev)->has_bfloat &&
+            !ggml_metal_device_get_props(dev)->has_tensor &&
+            getenv("GGML_METAL_PRECOMPILED_DISABLE") == NULL) {
+            extern const char ggml_metallib_precompiled_start[];
+            extern const char ggml_metallib_precompiled_end[];
+
+            dispatch_data_t data = dispatch_data_create(
+                ggml_metallib_precompiled_start,
+                ggml_metallib_precompiled_end - ggml_metallib_precompiled_start,
+                NULL, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+
+            library = [device newLibraryWithData:data error:&error];
+            dispatch_release(data);
+
+            if (library) {
+                GGML_LOG_INFO("%s: using precompiled embedded metal library\n", __func__);
+            } else {
+                GGML_LOG_WARN("%s: precompiled metal library rejected, compiling from source: %s\n", __func__,
+                        error ? [[error description] UTF8String] : "unknown error");
+                error = nil;
+            }
+        }
+#endif // GGML_METAL_EMBED_PRECOMPILED
 #else
 
 #ifdef SWIFT_PACKAGE
