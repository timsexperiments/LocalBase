diff --git a/examples/common/require_gpu_pci.h b/examples/common/require_gpu_pci.h
new file mode 100644
index 0000000..8a14cc2
--- /dev/null
+++ b/examples/common/require_gpu_pci.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+struct LocalBaseGpuDevice {
+    std::string name;
+    std::string registry;
+    std::string pci;
+    bool discrete;
+};
+
+inline bool localbase_valid_gpu_pci(const std::string& pci) {
+    if (pci.size() != 12 || pci[4] != ':' || pci[7] != ':' || pci[10] != '.') {
+        return false;
+    }
+    for (size_t i = 0; i < pci.size(); ++i) {
+        if (i == 4 || i == 7 || i == 10) continue;
+        if (!((pci[i] >= '0' && pci[i] <= '9') || (pci[i] >= 'a' && pci[i] <= 'f'))) {
+            return false;
+        }
+    }
+    return pci[8] <= '1' && pci[11] <= '7';
+}
+
+inline bool localbase_resolve_gpu_pci(const std::string& pci,
+                                      const std::vector<LocalBaseGpuDevice>& devices,
+                                      std::string& backend,
+                                      std::string& error) {
+    if (!localbase_valid_gpu_pci(pci)) {
+        error = "--require-gpu-pci requires one canonical lowercase PCI address DDDD:BB:DD.F";
+        return false;
+    }
+    if (!backend.empty()) {
+        error = "--require-gpu-pci conflicts with --backend";
+        return false;
+    }
+    std::string selected;
+    for (const auto& device : devices) {
+        if (!device.discrete || device.registry != "Vulkan" || device.pci != pci) continue;
+        if (!selected.empty()) {
+            error = "--require-gpu-pci requires exactly one matching discrete Vulkan GPU";
+            return false;
+        }
+        selected = device.name;
+    }
+    if (selected.empty()) {
+        error = "--require-gpu-pci requires exactly one matching discrete Vulkan GPU";
+        return false;
+    }
+    backend = selected;
+    return true;
+}
