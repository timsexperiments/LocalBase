--- a/examples/server/require-gpu-pci.h
+++ b/examples/server/require-gpu-pci.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "ggml-backend.h"
+#include <cstring>
+#include <string>
+
+static bool whisper_valid_gpu_pci(const std::string & pci) {
+    if (pci.size() != 12 || pci[4] != ':' || pci[7] != ':' || pci[10] != '.') {
+        return false;
+    }
+    for (size_t i = 0; i < pci.size(); ++i) {
+        if (i == 4 || i == 7 || i == 10) {
+            continue;
+        }
+        if (!((pci[i] >= '0' && pci[i] <= '9') || (pci[i] >= 'a' && pci[i] <= 'f'))) {
+            return false;
+        }
+    }
+    return pci[8] <= '1' && pci[11] <= '7';
+}
+
+static int whisper_find_gpu_pci(const std::string & pci) {
+    if (!whisper_valid_gpu_pci(pci)) {
+        return -1;
+    }
+    int ordinal = 0;
+    int selected = -1;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        const auto type = ggml_backend_dev_type(dev);
+        if (type != GGML_BACKEND_DEVICE_TYPE_GPU && type != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            continue;
+        }
+        ggml_backend_dev_props props = {};
+        ggml_backend_dev_get_props(dev, &props);
+        const char * backend = ggml_backend_reg_name(ggml_backend_dev_backend_reg(dev));
+        if (type == GGML_BACKEND_DEVICE_TYPE_GPU && backend && std::strcmp(backend, "Vulkan") == 0 &&
+                props.device_id && pci == props.device_id) {
+            if (selected >= 0) {
+                return -1;
+            }
+            selected = ordinal;
+        }
+        ++ordinal;
+    }
+    return selected;
+}
