== a policy
request: {"action":"apply-policy","expectedPolicyRevision":null,"policy":{"roles":[{"name":"chat","description":"","permissions":["inference:chat"]},{"name":"admin","description":"","permissions":["access:read","access:manage"]}],"bindings":[{"kind":"email","role":"admin","email":"owner@example.test"}],"defaultRole":null}}
status: 200
answer: {
    "policy": {
      "roles": [
        {
          "name": "chat",
          "description": "",
          "permissions": [
            "inference:chat"
          ]
        },
        {
          "name": "admin",
          "description": "",
          "permissions": [
            "access:read",
            "access:manage"
          ]
        }
      ],
      "bindings": [
        {
          "kind": "email",
          "role": "admin",
          "email": "owner@example.test",
          "issuer": "https://a.example.test"
