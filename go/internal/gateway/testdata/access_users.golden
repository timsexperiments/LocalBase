== invite with no provider
request: {"action":"invite-user","email":"friend@example.test","roles":["chat"]}
status: 409
answer: {
    "error": {
      "code": "provider_not_configured",
      "message": "Configure a browser identity provider first."
    }
  }
audit: audit.access-refused invite-user
ui-access.json: (none)
email-delivery.json: (none)
users: []

== a provider
request: {"action":"upsert-oidc","registration":{"kind":"oidc","id":"a","name":"P","issuer":"https://a.example.test","clientId":"x","clientAuthentication":{"kind":"none"}},"origin":"https://lb.example.test","permissions":["inference:chat","access:manage","access:read"]}
status: 200
answer: {
    "config": {
      "origin": "https://lb.example.test",
      "permissions": [
        "inference:chat",
        "access:read",
        "access:manage"
      ],
      "provider": {
        "kind": "direct",
        "registrations": [
          {
            "clientAuthentication": "none",
            "clientId": "x",
            "id": "a",
            "issuer": "https://a.example.test",
            "kind": "oidc",
            "name": "P"
          }
        ]
      }
    },
    "restartRequired": true
  }
audit: audit.access-changed upsert-oidc
ui-access.json: {
  "provider": {
    "kind": "direct",
    "registrations": [
      {
        "kind": "oidc",
        "id": "a",
        "name": "P",
        "issuer": "https://a.example.test",
        "clientId": "x",
        "clientAuthentication": {
          "kind": "none"
        }
      }
    ]
  },
  "origin": "https://lb.example.test",
  "permissions": [
    "inference:chat",
    "access:read",
    "access:manage"
  ]
}
email-delivery.json: (none)
users: []

