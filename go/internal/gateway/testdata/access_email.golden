== a test email with none configured
request: {"action":"test-email-delivery","to":"friend@example.test"}
status: 409
answer: {
    "error": {
      "code": "email_delivery_not_configured",
      "message": "Configure email delivery before enabling magic-link authentication."
    }
  }
audit: audit.access-refused test-email-delivery
ui-access.json: (none)
email-delivery.json: (none)

== disable with none configured
request: {"action":"disable-email-delivery"}
status: 200
answer: {
    "emailDeliveryDisabled": false,
    "restartRequired": false
  }
audit: 
ui-access.json: (none)
email-delivery.json: (none)

== configure
request: {"action":"configure-email-delivery","config":{"host":"smtp.example.test","port":587,"security":"starttls","authentication":{"kind":"password","username":"user","password":"PLANTED-smtp-password"},"from":"sender@example.test"}}
status: 200
answer: {
    "emailDelivery": {
      "authentication": "password",
      "from": "sender@example.test",
      "host": "smtp.example.test",
      "port": 587,
      "security": "starttls"
    },
    "restartRequired": false
  }
audit: audit.access-changed configure-email-delivery
ui-access.json: (none)
email-delivery.json: {
  "host": "smtp.example.test",
  "port": 587,
  "security": "starttls",
  "authentication": {
    "kind": "password",
    "username": "user",
    "password": "PLANTED-smtp-password"
  },
  "from": "sender@example.test"
}

