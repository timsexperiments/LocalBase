== OpenID Connect replaces Cloudflare
request: {"action":"upsert-oidc","registration":{"kind":"oidc","id":"b","name":"B","issuer":"https://b.example.test","clientId":"client","clientAuthentication":{"kind":"client-secret-basic","clientSecret":"PLANTED-oidc-secret"}},"origin":"https://lb.example.test","permissions":["inference:chat","access:manage","access:read"]}
status: 200
answer: {
    "config": {
      "origin": "https://lb.example.test",
      "permissions": [
        "inference:chat",
        "access:read",
        "access:manage"
      ],
      "provider": {
        "kind": "direct",
        "registrations": [
          {
            "clientAuthentication": "client-secret-basic",
            "clientId": "client",
            "id": "b",
            "issuer": "https://b.example.test",
            "kind": "oidc",
            "name": "B"
          }
        ]
      }
    },
    "restartRequired": true
  }
