== remove from nothing
request: {"action":"remove-registration","registrationId":"a"}
status: 404
answer: {
    "error": {
      "code": "registration_not_found",
      "message": "The identity provider registration was not found."
    }
  }
audit: audit.access-refused remove-registration
ui-access.json: (none)
email-delivery.json: (none)

== Cloudflare
request: {"action":"configure-cloudflare","provider":{"kind":"cloudflare-access","teamDomain":"team.cloudflareaccess.com","audience":"aud"},"origin":"https://lb.example.test","permissions":["inference:chat","access:manage","access:read"]}
status: 200
answer: {
    "config": {
      "origin": "https://lb.example.test",
      "permissions": [
        "inference:chat",
        "access:read",
        "access:manage"
      ],
      "provider": {
        "audience": "aud",
        "kind": "cloudflare-access",
        "teamDomain": "team.cloudflareaccess.com"
      }
    },
    "restartRequired": true
  }
audit: audit.access-changed configure-cloudflare
ui-access.json: {
  "provider": {
    "kind": "cloudflare-access",
    "teamDomain": "team.cloudflareaccess.com",
    "audience": "aud"
  },
  "origin": "https://lb.example.test",
  "permissions": [
    "inference:chat",
    "access:read",
    "access:manage"
  ]
}
email-delivery.json: (none)

