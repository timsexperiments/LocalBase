option {Name:audience Alias: Bool:false Repeatable:false Value:<AUD tag> Help:Cloudflare Access application audience Default:}
option {Name:origin Alias: Bool:false Repeatable:false Value:<https://localbase.example.com> Help:Exact public UI origin Default:}
option {Name:permissions Alias: Bool:false Repeatable:false Value:<permission,...> Help:Browser permissions; preserves the current set when omitted Default:}
