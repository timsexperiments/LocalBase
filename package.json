{
  "name": "local-base",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "An OpenAI-compatible gateway for local AI runtimes, with model management and a web interface.",
  "repository": "git+https://github.com/timsexperiments/LocalBase.git",
  "homepage": "https://github.com/timsexperiments/LocalBase#readme",
  "bugs": "https://github.com/timsexperiments/LocalBase/issues",
  "author": {
    "name": "TimsExperiments",
    "url": "https://github.com/timsexperiments"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "postinstall": "bun run db:prepare",
    "db:prepare": "bun run scripts/generate-migration-assets.ts && bun run scripts/build-ui.ts",
    "local-base": "bun run src/cli.ts",
    "format": "bunx prettier --write src scripts drizzle.config.ts",
    "check": "bunx prettier --check src scripts drizzle.config.ts && bun run typecheck && bun run src/cli.ts --help",
    "db:generate": "bunx drizzle-kit generate && bun run db:prepare",
    "db:check": "bunx drizzle-kit check && bun run scripts/check-migration-assets.ts",
    "typecheck": "bunx tsgo --noEmit",
    "catalog:feed": "bun run scripts/build-catalog-feed.ts",
    "build": "bun run db:prepare && bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --asset-naming='[dir]/[name].[ext]' --outfile dist/local-base"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/openai-compatible": "3.0.84",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "ai": "7.0.162",
    "drizzle-kit": "^0.31.11",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/otlp-transformer": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "ajv": "8.20.0",
    "citty": "0.2.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "jose": "6.2.15",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "nodemailer": "10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.7"
  }
}
