FROM oven/bun:1.3.14-debian

ARG ARTIFACT_DIR=extracted/linux-arm64
ARG ARTIFACT_TARGET=linux-arm64

WORKDIR /workspace

COPY package.json bun.lock drizzle.config.ts tsconfig.json ./
COPY drizzle ./drizzle
COPY scripts ./scripts
COPY src ./src
COPY ${ARTIFACT_DIR}/local-base-${ARTIFACT_TARGET} /opt/localbase/local-base

RUN bun install --frozen-lockfile \
  && chmod +x /opt/localbase/local-base \
  && install -d -m 0700 /tmp/localbase

ENV LOCALBASE_SMOKE_CLI=/opt/localbase/local-base \
  LOCALBASE_SMOKE_TARGET=${ARTIFACT_TARGET} \
  RUNNER_TEMP=/tmp/localbase

ENTRYPOINT ["bun", "test", "--timeout", "120000", "scripts/runtime-smoke.test.ts"]
