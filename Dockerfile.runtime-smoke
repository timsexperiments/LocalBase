FROM ubuntu:24.04

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates libgomp1 \
  && rm -rf /var/lib/apt/lists/*

COPY dist/runtime-smoke/local-base-linux-x64 /usr/local/bin/local-base
COPY dist/runtime-smoke/runtime-smoke-linux-x64 /usr/local/bin/localbase-runtime-smoke

ENV LOCALBASE_SMOKE_CLI=/usr/local/bin/local-base

USER 65534:65534

ENTRYPOINT ["/usr/local/bin/localbase-runtime-smoke"]
